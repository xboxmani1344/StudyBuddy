# Copy this file to .env and fill in your key.

# Required for the AI to respond at all.
# Get a free key (no credit card) at https://openrouter.ai/keys
OPENROUTER_API_KEY=paste-your-key-here

# Optional overrides
# PORT=3000
# DB_PATH=./data/study-buddy.db
#
# OPENROUTER_MODEL defaults to nvidia/nemotron-3-super-120b-a12b:free. Any model works, but the
# ones ending in ":free" cost nothing. Other free options worth trying:
#   nvidia/nemotron-3-ultra-550b-a55b:free   — very large, slower
#   google/gemma-4-31b-it:free               — instruction-tuned, quick
#   openai/gpt-oss-20b:free                  — small and fast
#   openrouter/free                          — auto-picks whichever free
#                                              model is available right now
# Current list: https://openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: enables "Continue with Google" on the sign-in screen.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application) and add this app's callback URL
# (e.g. http://localhost:3000/api/auth/google/callback) as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Optional: the app's public base URL, e.g. https://study-buddy.onrender.com
# Only needed if your host's proxy headers confuse the auto-detected URL used for
# Stripe redirects. Leave unset for local development.
# APP_URL=

# Optional: enables real subscription upgrades (Stripe Checkout + billing portal).
# Create a Product/Price in your Stripe Dashboard (test mode is fine) for the paid
# plan, and a webhook endpoint pointing at <your-app-url>/api/billing/webhook
# listening for: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted. Without these, the app runs fully on the free
# plan and the "Upgrade" button just explains that billing isn't configured yet.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
